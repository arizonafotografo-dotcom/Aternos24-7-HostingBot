const mineflayer = require('mineflayer');
const express = require('express');
const fs = require('fs');

// Carrega as configurações do settings.json
let settings;
try {
    settings = JSON.parse(fs.readFileSync('settings.json', 'utf8'));
} catch (err) {
    console.error('[Erro] Não foi possível ler o arquivo settings.json:', err.message);
    process.exit(1);
}

const app = express();
const PORT = process.env.PORT || 5000;

// Servidor Web para o Bot-Hosting não derrubar a aplicação
app.get('/', (req, res) => {
    res.send(`🤖 Bot ${settings.name} está online e rodando no Bot-Hosting!`);
});

app.get('/ping', (req, res) => {
    res.status(200).send('pong');
});

app.listen(PORT, () => {
    console.log(`[Server] Servidor HTTP ativo na porta ${PORT}`);
});

let bot;
let reconnectTimeout;

function createBot() {
    console.log(`=========================================`);
    console.log(`[Bot] Conectando a ${settings.server.ip}:${settings.server.port || 25565}`);
    
    bot = mineflayer.createBot({
        host: settings.server.ip,
        port: settings.server.port === 0 ? undefined : settings.server.port,
        username: settings["bot-account"].username,
        version: settings.server.version || false,
        auth: settings["bot-account"].type === "offline" ? "offline" : "microsoft"
    });

    // Quando o bot entra com sucesso no servidor
    bot.once('spawn', () => {
        console.log(`[Bot] Spawned com sucesso no servidor! (Versão: ${bot.version})`);
        
        // DELAY DE SEGURANÇA: Espera 5 segundos para o mundo carregar antes de iniciar as funções
        setTimeout(() => {
            console.log(`[Modules] Ativando rotinas de movimentação com segurança...`);
            
            // Inicia o anti-afk básico sem sobrecarregar a rede
            if (settings.movement.enabled) {
                setInterval(() => {
                    if (bot && bot.entity) {
                        // Faz o bot olhar levemente para o lado a cada intervalo para simular jogador humano
                        const yaw = bot.entity.yaw + (Math.random() - 0.5) * 0.5;
                        const pitch = bot.entity.pitch + (Math.random() - 0.5) * 0.2;
                        bot.look(yaw, pitch);
                    }
                }, settings.movement["look-around"].interval || 8000);

                if (settings.movement["random-jump"].enabled) {
                    setInterval(() => {
                        if (bot && bot.entity) {
                            bot.setControlState('jump', true);
                            setTimeout(() => { if (bot) bot.setControlState('jump', false); }, 500);
                        }
                    }, settings.movement["random-jump"].interval || 15000);
                }
            }
            console.log(`[Modules] Todos os módulos anti-kick foram inicializados.`);
        }, 5000); // 5000 milissegundos = 5 segundos de espera
    });

    // Gerenciamento de Erros para evitar que o processo do Bot-Hosting caia
    bot.on('error', (err) => {
        console.log(`[Erro Capturado] Ocorreu uma falha de conexão: ${err.code || err.message}`);
        if (err.code === 'ECONNRESET' || err.code === 'ECONNREFUSED') {
            handleReconnect();
        }
    });

    bot.on('end', (reason) => {
        console.log(`[Bot] Conexão encerrada pelo servidor. Motivo: ${reason}`);
        handleReconnect();
    });
}

// Função de reconexão inteligente com proteção contra spam de login
function handleReconnect() {
    if (reconnectTimeout) return;

    const delay = settings.utils["auto-reconnect-delay"] || 15000;
    console.log(`[Anti-Spam] Aguardando ${delay / 1000} segundos antes de tentar reconectar...`);
    
    reconnectTimeout = setTimeout(() => {
        reconnectTimeout = null;
        createBot();
    }, delay);
}

// Captura erros globais para o contêiner do Node nunca desligar
process.on('uncaughtException', (err) => {
    console.log(`[Sistema] Erro global evitado: ${err.message}`);
    handleReconnect();
});

// Inicializa o Bot pela primeira vez
createBot();
